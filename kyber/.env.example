# Kyber Telegram Bot Configuration
# Copy this file to .env and fill in your values.
#
# Get a bot token from @BotFather on Telegram:
#   1. Open Telegram, search for @BotFather
#   2. Send /newbot and follow the prompts
#   3. Copy the token here

KYBER_TELEGRAM_BOT_TOKEN=your-bot-token-here

# Comma-separated Telegram chat IDs that can interact with the bot.
# Leave empty to allow all chats (not recommended for production).
# To find your chat ID, message @userinfobot on Telegram.
KYBER_TELEGRAM_ALLOWED_CHATS=

# Chat ID where algedonic (pain/pleasure) alerts are sent.
# Typically a group chat or channel for ops monitoring.
KYBER_TELEGRAM_ALERTS_CHAT=

# Default task type for free-text messages (no /command prefix).
# Must match a capability registered with a Kyber agent.
KYBER_TELEGRAM_DEFAULT_TASK=prompt

# Minimum severity (1-10) for forwarding algedonic signals to Telegram.
# 5 = moderate and above, 7 = pain/HITL signals only
KYBER_TELEGRAM_ALERT_MIN_SEVERITY=5
